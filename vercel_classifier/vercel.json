{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/classify.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "framework": null,
  "outputDirectory": "public"
}
